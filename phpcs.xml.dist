<?xml version="1.0"?>
<ruleset name="HeroSliderWithSplideJS">
    <description>Coding standards for Hero Slider with SplideJS</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/assets/js/splide.min.js</exclude-pattern>
    <exclude-pattern>/assets/css/splide.min.css</exclude-pattern>

    <arg value="sp"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>

    <rule ref="WordPress-Extra">
        <exclude name="WordPress.Files.FileName"/>
    </rule>
    <rule ref="WordPress-Docs"/>

    <config name="minimum_supported_wp_version" value="5.2"/>
    <config name="testVersion" value="7.2-"/>
</ruleset>
